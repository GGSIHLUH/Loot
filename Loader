-- Hash FNV-1a 32-bit (hasilnya sama persis dengan versi JavaScript di website)
local function mix(str)
	local h = 2166136261
	for i = 1, #str do
		h = bit32.bxor(h, string.byte(str, i))
		h = (h + bit32.lshift(h, 1) + bit32.lshift(h, 4) + bit32.lshift(h, 7)
			+ bit32.lshift(h, 8) + bit32.lshift(h, 24)) % 4294967296
	end
	return h
end

local function getTodayKey()
	local day = math.floor(os.time() / 86400) -- berganti tiap 1 hari
	local a = mix(SECRET .. ":" .. day .. ":A")
	local b = mix(SECRET .. ":" .. day .. ":B")
	return PREFIX .. string.format("%08X%08X", a, b)
end

